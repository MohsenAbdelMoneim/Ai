# ============================================================
# Mohsen AI — Environment Variables Example
# ============================================================
# انسخ الملف ده باسم .env
# وحط فيه المفاتيح الحقيقية
# ⚠️ متحطش أي مفاتيح حقيقية في الملف ده (.env.example)
# ============================================================

# ---------- Server ----------
PORT=3000
# Comma not needed; set to your production origin, e.g. https://mohsen-ai.example.com (empty = same-origin only)
CORS_ORIGIN=

# ---------- Free usage limits ----------
FREE_MESSAGES_PER_HOUR=20
FREE_MESSAGES_PER_DAY=100
MAX_MESSAGE_LENGTH=12000
MAX_CONCURRENT=2
STREAM_TIMEOUT_MS=15000

# ---------- Provider API keys ----------
# Server-side only — never sent to the browser
# ⚠️ ضع القيم الحقيقية في .env مش هنا

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZAI_API_KEY=your_zai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
SEARCH_API_KEY=your_tavily_api_key_here